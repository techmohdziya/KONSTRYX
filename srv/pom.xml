<?xml version="1.0" encoding="UTF-8" standalone="no"?><project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.inflexion.konstryx</groupId>
    <artifactId>konstryx</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>konstryx-srv</artifactId>
  <packaging>jar</packaging>
  <name>KONSTRYX :: srv</name>

  <!--
    Hold the SAP security artifacts on the 3.7.4 line CAP is built against.

    connectivity-destination-service (below) depends on java-security /
    java-api / env at 4.0.7, and Maven's nearest-wins would take them. CAP's
    own spring-security stays at 3.7.4 and calls
    JwtValidatorBuilder.withHttpClient(CloseableHttpClient), which 4.0.7
    removed - so the mixed classpath does not fail at destination lookup, it
    fails at startup, in Spring Security bean creation, with a message naming
    neither this dependency nor the destination. It crash-looped the deployed
    service on 2026-08-24 (I-47).

    Re-check with `mvn -pl srv dependency:tree` after any CAP upgrade: this
    version must track whatever cds-starter-cloudfoundry pulls for
    resourceserver-security-spring-boot-starter.
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.sap.cloud.security</groupId>
        <artifactId>java-security</artifactId>
        <version>3.7.4</version>
      </dependency>
      <dependency>
        <groupId>com.sap.cloud.security</groupId>
        <artifactId>java-api</artifactId>
        <version>3.7.4</version>
      </dependency>
      <dependency>
        <groupId>com.sap.cloud.security</groupId>
        <artifactId>env</artifactId>
        <version>3.7.4</version>
      </dependency>
      <!--
        token-client belongs to the same family and MUST move with it.

        Left at 4.0.7 against a 3.7.4 java-security, it throws
        ClassNotFoundException: com.sap.cloud.security.util.LogSanitizer from
        inside DefaultOAuth2TokenKeyService while fetching the XSUAA public
        key. That is JWT SIGNATURE VALIDATION failing, so every token is
        rejected and every authenticated request answers 401 - the deployed UI
        loads, calls /odata, gets 401 on all of it and renders empty tables.
        "No data" and "no authentication" are indistinguishable in the browser,
        which is how this survived from the first deployment.
      -->
      <dependency>
        <groupId>com.sap.cloud.security.xsuaa</groupId>
        <artifactId>token-client</artifactId>
        <version>3.7.4</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- includes cds-adapter-odata-v4; the plain -spring-boot starter has no
         protocol adapter and silently exposes no endpoints -->
    <dependency>
      <groupId>com.sap.cds</groupId>
      <artifactId>cds-starter-spring-boot-odata</artifactId>
    </dependency>
    <dependency>
      <groupId>com.sap.cds</groupId>
      <artifactId>cds-feature-hana</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- S/4HANA Cloud / Ariba / SuccessFactors connectivity -->
    <dependency>
      <groupId>com.sap.cds</groupId>
      <artifactId>cds-feature-remote-odata</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!--
      The loader that actually reads the BTP destination service.

      cloudplatform-connectivity (transitive, above) provides the
      DestinationAccessor API but registers only EnvVarDestinationLoader, which
      reads a `destinations` environment variable and nothing else. With just
      that on the classpath, DestinationAccessor.getDestination("ITS_S4")
      throws DestinationNotFoundException on a correctly-bound Cloud Foundry
      app - indistinguishable from "the destination was never created".
      Verified on the tenant: with this artifact present the same code logs
      `S/4 connection uses destination ITS_S4`.

      Version pinned because the CAP BOM does not manage the Cloud SDK's own
      artifacts; it must match the cloudplatform-connectivity version CAP pulls
      in transitively. See dependencyManagement above for the security-artifact
      pin this dependency makes necessary.
    -->
    <dependency>
      <groupId>com.sap.cloud.sdk.cloudplatform</groupId>
      <artifactId>connectivity-destination-service</artifactId>
      <version>5.32.0</version>
      <scope>runtime</scope>
    </dependency>
    <!-- XSUAA security (active in cloud profile) -->
    <dependency>
      <groupId>com.sap.cds</groupId>
      <artifactId>cds-starter-cloudfoundry</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

  	<dependency>
  		<groupId>com.h2database</groupId>
  		<artifactId>h2</artifactId>
  		<scope>runtime</scope>
  	</dependency>
  </dependencies>

  <build>
    <finalName>${project.artifactId}</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring.boot.version}</version>
        <executions>
          <execution>
            <goals><goal>repackage</goal></goals>
            <configuration>
              <!-- mta.yaml build-result is target/*-exec.jar -->
              <classifier>exec</classifier>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- cds maven plugin: compile CDS model into srv resources -->
      <plugin>
        <groupId>com.sap.cds</groupId>
        <artifactId>cds-maven-plugin</artifactId>
        <version>${cds.services.version}</version>
        <executions>
          <execution>
            <id>cds.build</id>
            <goals><goal>cds</goal></goals>
            <configuration>
              <commands>
                <command>build --for java</command>
              	<command>deploy --to h2 --with-mocks --dry --out "${project.basedir}/src/main/resources/schema-h2.sql"</command>
              </commands>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>