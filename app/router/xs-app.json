{
  "welcomeFile": "/konstryx/index.html",
  "authenticationMethod": "route",
  "sessionTimeout": 30,
  "routes": [
    {
      "source": "^/odata/(.*)$",
      "target": "/odata/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^(/.*)$",
      "authenticationType": "xsuaa",
      "service": "html5-apps-repo-rt",
      "csrfProtection": false
    }
  ]
}
