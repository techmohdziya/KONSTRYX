<mvc:View
	controllerName="konstryx.controller.PromotionQueue"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.f"
	xmlns:core="sap.ui.core"
	height="100%">

	<f:DynamicPage id="queuePage" headerExpanded="true" fitContent="false">

		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<VariantManagement id="queueVariant"
					                   supportDefault="true"
					                   supportFavorites="false"
					                   supportPublic="true"
					                   select=".onVariantSelect"
					                   save=".onVariantSave"/>
				</f:heading>
				<f:snappedHeading>
					<Title text="Promotion Queue" level="H2"/>
				</f:snappedHeading>
				<f:expandedContent>
					<Text text="Requests to share a company-local master across the whole group. Approving changes every company's costing, so it is a decision with an owner and a record."/>
				</f:expandedContent>
			</f:DynamicPageTitle>
		</f:title>

		<f:header>
			<f:DynamicPageHeader pinnable="true">
				<HBox wrap="Wrap" class="kxFilterBar" alignItems="End">
					<VBox class="kxFilterField">
						<Label text="Status"/>
						<Select id="statusFilter" selectedKey="PENDING" change=".onFilterChange">
							<core:Item key="PENDING" text="Awaiting a decision"/>
							<core:Item key="APPROVED" text="Approved"/>
							<core:Item key="REJECTED" text="Rejected"/>
							<core:Item key="ALL" text="All"/>
						</Select>
					</VBox>
					<VBox class="kxFilterField">
						<Label text=" "/>
						<Button text="Adapt Filters" icon="sap-icon://filter"
						        tooltip="Choose which filters appear here"
						        press=".onAdaptFilters"/>
					</VBox>
				</HBox>
			</f:DynamicPageHeader>
		</f:header>

		<f:content>
			<Table
				id="queueTable"
				items="{path: 'md>/PromotionRequests', templateShareable: false}"
				growing="true"
				growingThreshold="50"
				sticky="ColumnHeaders"
				mode="SingleSelectMaster"
				selectionChange=".onSelect"
				class="sapUiResponsiveMargin"
				width="auto">

				<headerToolbar>
					<OverflowToolbar>
						<Title id="tableTitle" text="Requests" level="H4"/>
						<ToolbarSpacer/>
						<Button icon="sap-icon://excel-attachment" text="Export to Excel"
						        tooltip="Download the list as it is arranged here"
						        press=".onExportExcel"/>
						<Button icon="sap-icon://print" text="Print"
						        tooltip="Print, or save as PDF from the print dialog"
						        press=".onPrint"/>
						<Button icon="sap-icon://action-settings" tooltip="Columns, sort, group and filter"
						        press=".onTableSettings"/>
						<ObjectStatus text="live · CAP OData V4" state="Success" icon="sap-icon://connected" visible="{/ui/showIntegrationStatus}"/>
					</OverflowToolbar>
				</headerToolbar>

				<columns>
					<Column id="objectKey" width="12rem"><Text text="Master"/></Column>
					<Column id="objectType" minScreenWidth="Tablet" demandPopin="true"><Text text="Object type"/></Column>
					<Column id="currentScope" width="12rem"><Text text="Scope change"/></Column>
					<Column id="requester" width="12rem" minScreenWidth="Desktop" demandPopin="true"><Text text="Requested by"/></Column>
					<Column id="comment" minScreenWidth="Desktop" demandPopin="true"><Text text="Reason"/></Column>
					<Column id="status" width="10rem"><Text text="Status"/></Column>
					<Column id="decidedBy" width="12rem" minScreenWidth="Desktop" demandPopin="true"><Text text="Decided by"/></Column>
				</columns>

				<items>
					<ColumnListItem>
						<cells>
							<Link text="{md>objectKey}" press=".onObjectLink"/>
							<Text text="{md>objectType}"/>
							<HBox alignItems="Center">
								<ObjectStatus text="{md>currentScope}" state="Warning"/>
								<core:Icon src="sap-icon://arrow-right" class="sapUiTinyMarginBeginEnd"/>
								<ObjectStatus text="{md>proposedScope}" state="Success"/>
							</HBox>
							<Text text="{md>requester}"/>
							<Text text="{md>comment}"/>
							<ObjectStatus
								text="{md>status}"
								state="{= ${md>status} === 'APPROVED' ? 'Success' : ${md>status} === 'REJECTED' ? 'Error' : 'Warning' }"/>
							<Text text="{= ${md>decidedBy} ? ${md>decidedBy} : '—' }"/>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</f:content>

		<f:footer>
			<OverflowToolbar>
				<Text id="selectionHint" text="Select a pending request to decide it."/>
				<ToolbarSpacer/>
				<Button id="rejectButton" text="Reject" type="Reject" icon="sap-icon://decline"
					enabled="false" press=".onReject"/>
				<Button id="approveButton" text="Approve" type="Accept" icon="sap-icon://accept"
					enabled="false" press=".onApprove"/>
			</OverflowToolbar>
		</f:footer>
	</f:DynamicPage>
</mvc:View>
