<mvc:View
	controllerName="konstryx.controller.MasterResources"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.f"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table"
	height="100%">

	<f:DynamicPage id="masterResourcePage" headerExpanded="true" fitContent="true">

		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="Resource Hierarchy" level="H2"/>
				</f:heading>
				<f:expandedContent>
					<Text text="L1 to L5. A group master is shared across every company; a company master belongs to one legal entity and is invisible to the others."/>
				</f:expandedContent>
				<f:actions>
					<Button text="Create" type="Emphasized" icon="sap-icon://add" press=".onNotImplemented"/>
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>

		<f:header>
			<f:DynamicPageHeader pinnable="true">
				<HBox wrap="Wrap" class="kxFilterBar" alignItems="End">
					<VBox class="kxFilterField">
						<Label text="Scope"/>
						<Select id="scopeFilter" selectedKey="ALL" change=".onFilterChange">
							<core:Item key="ALL" text="All scopes"/>
							<core:Item key="GROUP" text="Group - shared"/>
							<core:Item key="COMPANY" text="Company - local"/>
						</Select>
					</VBox>
					<VBox class="kxFilterField">
						<Label text="Vertical"/>
						<Select id="verticalFilter" selectedKey="ALL" change=".onFilterChange">
							<core:Item key="ALL" text="All verticals"/>
							<core:Item key="EQR" text="EQR - Equipment"/>
							<core:Item key="MR" text="MR - Material"/>
							<core:Item key="MPR" text="MPR - Manpower"/>
							<core:Item key="VR" text="VR - Vehicle"/>
						</Select>
					</VBox>
					<VBox class="kxFilterField">
						<Label text="Search"/>
						<SearchField id="masterSearch" width="16rem" liveChange=".onSearch" placeholder="Code or description"/>
					</VBox>
				</HBox>
			</f:DynamicPageHeader>
		</f:header>

		<f:content>
			<!-- A TreeTable, not a list. L1 to L5 is the point of this master: a
			     flat table sorted by code puts a crane next to a cabin and gives
			     no way to see which category either belongs to. -->
			<t:TreeTable
				id="resourceTree"
				rows="{path: 'tree>/nodes', parameters: {arrayNames: ['children']}}"
				selectionMode="Single"
				selectionBehavior="RowOnly"
				rowSelectionChange=".onSelect"
				visibleRowCountMode="Fixed"
				visibleRowCount="16"
				enableColumnReordering="true"
				columnHeaderVisible="true">

				<t:extension>
					<OverflowToolbar>
						<Title id="tableTitle" text="Resources" level="H4"/>
						<ToolbarSpacer/>
						<Button icon="sap-icon://expand-all" text="Expand all" press=".onExpandAll"/>
						<Button icon="sap-icon://collapse-all" text="Collapse" press=".onCollapseAll"/>
						<ObjectStatus text="live · CAP OData V4" state="Success" icon="sap-icon://connected" visible="{/ui/showIntegrationStatus}"/>
					</OverflowToolbar>
				</t:extension>

				<t:columns>
					<t:Column width="20rem">
						<Label text="Code"/>
						<t:template>
							<!-- A row kept only to place a search hit inside its branch is
							     left unemphasised, so it is obvious which rows actually
							     matched. Bound to emphasized rather than to class: class is
							     not a bindable property in an XML view, it is applied once at
							     creation, and binding it fails silently. -->
							<Link text="{tree>code}" press=".onNavigateToDetail"
							      emphasized="{tree>isMatch}"/>
						</t:template>
					</t:Column>
					<t:Column width="5rem">
						<Label text="Level"/>
						<t:template><Text text="{tree>level}"/></t:template>
					</t:Column>
					<t:Column width="22rem">
						<Label text="Description"/>
						<t:template><Text text="{tree>description}" wrapping="false"/></t:template>
					</t:Column>
					<t:Column width="6rem">
						<Label text="Vertical"/>
						<t:template><Text text="{tree>verticalType}"/></t:template>
					</t:Column>
					<t:Column width="9rem">
						<Label text="Scope"/>
						<t:template>
							<!-- Group masters are the shared backbone; company masters are
							     local and deliberately stand out, since promoting one is a
							     decision that changes every other company's costing. -->
							<ObjectStatus
								text="{tree>scope}"
								state="{= ${tree>scope} === 'GROUP' ? 'Success' : 'Warning' }"
								icon="{= ${tree>scope} === 'GROUP' ? 'sap-icon://group' : 'sap-icon://building' }"/>
						</t:template>
					</t:Column>
					<t:Column width="14rem">
						<Label text="Owned by"/>
						<t:template>
							<Text text="{= ${tree>owningCompany/code} ? ${tree>owningCompany/code} : 'Whole group' }"/>
						</t:template>
					</t:Column>
					<t:Column width="8rem">
						<Label text="Status"/>
						<t:template>
							<ObjectStatus text="{tree>masterStatus}"
							              state="{= ${tree>masterStatus} === 'ACTIVE' ? 'Success' : 'None' }"/>
						</t:template>
					</t:Column>
				</t:columns>
			</t:TreeTable>
		</f:content>

		<f:footer>
			<OverflowToolbar>
				<Text id="selectionHint" text="Select a company-scoped master to request promotion to group scope."/>
				<ToolbarSpacer/>
				<Button
					id="promoteButton"
					text="Request promotion"
					type="Emphasized"
					icon="sap-icon://arrow-top"
					enabled="false"
					press=".onRequestPromotion"/>
			</OverflowToolbar>
		</f:footer>
	</f:DynamicPage>
</mvc:View>
