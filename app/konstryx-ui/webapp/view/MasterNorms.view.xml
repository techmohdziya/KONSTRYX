<mvc:View
	controllerName="konstryx.controller.MasterNorms"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.f"
	height="100%">

	<f:DynamicPage id="normsPage" headerExpanded="true" fitContent="false">

		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="Productivity &amp; Consumption Norms" level="H2"/>
				</f:heading>
				<f:expandedContent>
					<Text text="The norms the system derives from. Output achieved drives earned value; consumption per unit of output drives theoretical material usage, which is what site consumption is checked against."/>
				</f:expandedContent>
			</f:DynamicPageTitle>
		</f:title>

		<f:content>
			<IconTabBar id="normTabs" expanded="true" class="sapUiResponsiveContentPadding">

				<items>
					<IconTabFilter id="prodTab" text="Productivity" icon="sap-icon://trend-up" key="PROD">
						<Table id="prodTable" items="{path: 'md>/ProductivityRates', templateShareable: false}" sticky="ColumnHeaders">
							<headerToolbar>
								<OverflowToolbar>
									<Title id="prodTitle" text="Productivity norms" level="H4"/>
									<VariantManagement id="prodVariant" class="sapUiTinyMarginBegin"
									                   supportDefault="true" supportFavorites="false" supportPublic="true"
									                   select=".onProdVariantSelect" save=".onProdVariantSave"/>
									<ToolbarSpacer/>
									<Button text="Adapt Filters" icon="sap-icon://filter" tooltip="Filter this list" press=".onProdAdaptFilters"/>
									<Button icon="sap-icon://excel-attachment" text="Export to Excel"
									        tooltip="Download the list as it is arranged here" press=".onProdExportExcel"/>
									<Button icon="sap-icon://action-settings" tooltip="Columns, sort, group and filter" press=".onProdTableSettings"/>
									<ObjectStatus text="live · CAP OData V4" state="Success" icon="sap-icon://connected" visible="{/ui/showIntegrationStatus}"/>
								</OverflowToolbar>
							</headerToolbar>
							<columns>
								<Column id="resource" width="14rem"><Text text="Resource"/></Column>
								<Column id="crewComposition" minScreenWidth="Tablet" demandPopin="true"><Text text="Crew composition"/></Column>
								<Column id="outputPerHr" width="10rem" hAlign="End"><Text text="Per hour"/></Column>
								<Column id="outputPerManday8h" width="12rem" hAlign="End"><Text text="Per 8h man-day"/></Column>
								<Column id="prodBasis" minScreenWidth="Desktop" demandPopin="true"><Text text="Basis"/></Column>
								<Column id="prodScope" width="9rem"><Text text="Scope"/></Column>
							</columns>
							<items>
								<ColumnListItem>
									<cells>
										<VBox>
											<Link text="{md>resource/code}" press=".onProdResourceLink"/>
											<Text text="{md>resource/description}" class="kxSubText"/>
										</VBox>
										<Text text="{md>crewComposition}"/>
										<ObjectNumber
											number="{path: 'md>outputPerHr', type: 'sap.ui.model.odata.type.Decimal', formatOptions: {groupingEnabled: true, maxFractionDigits: 2}}"
											unit="{md>outputUoM}"/>
										<ObjectNumber
											number="{path: 'md>outputPerManday8h', type: 'sap.ui.model.odata.type.Decimal', formatOptions: {groupingEnabled: true, maxFractionDigits: 2}}"
											unit="{md>outputUoM}"/>
										<Text text="{md>basis}"/>
										<ObjectStatus text="{md>scope}"
											state="{= ${md>scope} === 'GROUP' ? 'Success' : 'Warning' }"
											icon="{= ${md>scope} === 'GROUP' ? 'sap-icon://group' : 'sap-icon://building' }"/>
									</cells>
								</ColumnListItem>
							</items>
						</Table>
					</IconTabFilter>

					<IconTabFilter id="consTab" text="Consumption" icon="sap-icon://measuring-point" key="CONS">
						<Table id="consTable" items="{path: 'md>/ConsumptionRates', templateShareable: false}" sticky="ColumnHeaders">
							<headerToolbar>
								<OverflowToolbar>
									<Title id="consTitle" text="Consumption norms" level="H4"/>
									<VariantManagement id="consVariant" class="sapUiTinyMarginBegin"
									                   supportDefault="true" supportFavorites="false" supportPublic="true"
									                   select=".onConsVariantSelect" save=".onConsVariantSave"/>
									<ToolbarSpacer/>
									<Button text="Adapt Filters" icon="sap-icon://filter" tooltip="Filter this list" press=".onConsAdaptFilters"/>
									<Button icon="sap-icon://excel-attachment" text="Export to Excel"
									        tooltip="Download the list as it is arranged here" press=".onConsExportExcel"/>
									<Button icon="sap-icon://action-settings" tooltip="Columns, sort, group and filter" press=".onConsTableSettings"/>
									<ObjectStatus text="live · CAP OData V4" state="Success" icon="sap-icon://connected" visible="{/ui/showIntegrationStatus}"/>
								</OverflowToolbar>
							</headerToolbar>
							<columns>
								<Column id="material" width="14rem"><Text text="Material"/></Column>
								<Column id="consRate" width="12rem" hAlign="End"><Text text="Rate"/></Column>
								<Column id="wastageAllowancePct" width="10rem" hAlign="End"><Text text="Wastage"/></Column>
								<Column id="consBasis" minScreenWidth="Tablet" demandPopin="true"><Text text="Basis"/></Column>
								<Column id="consScope" width="9rem"><Text text="Scope"/></Column>
								<Column id="owningCompany" width="14rem" minScreenWidth="Desktop" demandPopin="true"><Text text="Owned by"/></Column>
							</columns>
							<items>
								<ColumnListItem>
									<cells>
										<VBox>
											<Link text="{md>material/code}" press=".onConsResourceLink"/>
											<Text text="{md>material/description}" class="kxSubText"/>
										</VBox>
										<ObjectNumber
											number="{path: 'md>consRate', type: 'sap.ui.model.odata.type.Decimal', formatOptions: {groupingEnabled: true, maxFractionDigits: 3}}"
											unit="{md>consUoM}"/>
										<ObjectNumber
											number="{path: 'md>wastageAllowancePct', type: 'sap.ui.model.odata.type.Decimal', formatOptions: {maxFractionDigits: 2}}"
											unit="%"
											state="Warning"/>
										<Text text="{md>basis}"/>
										<ObjectStatus text="{md>scope}"
											state="{= ${md>scope} === 'GROUP' ? 'Success' : 'Warning' }"
											icon="{= ${md>scope} === 'GROUP' ? 'sap-icon://group' : 'sap-icon://building' }"/>
										<Text text="{= ${md>owningCompany/code} ? ${md>owningCompany/code} : 'Whole group' }"/>
									</cells>
								</ColumnListItem>
							</items>
						</Table>
					</IconTabFilter>
				</items>
			</IconTabBar>
		</f:content>
	</f:DynamicPage>
</mvc:View>
