<mvc:View
	controllerName="konstryx.controller.RequestDetail"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:uxap="sap.uxap"
	xmlns:form="sap.ui.layout.form"
	xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
	height="100%">

	<uxap:ObjectPageLayout
		id="requestObjectPage"
		showTitleInHeaderContent="true"
		alwaysShowContentHeader="false"
		preserveHeaderStateOnScroll="false"
		headerContentPinnable="true"
		isChildPage="true"
		upperCaseAnchorBar="false">

		<uxap:headerTitle>
			<uxap:ObjectPageDynamicHeaderTitle>
				<uxap:breadcrumbs>
					<Breadcrumbs currentLocationText="{view>/req/id}">
						<Link text="Home" press=".onBreadcrumbHome"/>
						<Link text="Resource Requests" press=".onBreadcrumbWorklist"/>
					</Breadcrumbs>
				</uxap:breadcrumbs>

				<uxap:expandedHeading>
					<HBox alignItems="Center" wrap="Wrap">
						<Title text="{view>/req/id} · {view>/req/title}" wrapping="true" level="H2"/>
						<ObjectStatus text="{view>/req/typeName}" inverted="true" state="Information" class="sapUiTinyMarginBegin"/>
						<ObjectStatus text="{view>/req/state}" state="{view>/req/stateType}" class="sapUiTinyMarginBegin"/>
					</HBox>
				</uxap:expandedHeading>
				<uxap:snappedHeading>
					<HBox alignItems="Center">
						<Title text="{view>/req/id} · {view>/req/title}" level="H2"/>
						<ObjectStatus text="{view>/req/state}" state="{view>/req/stateType}" class="sapUiTinyMarginBegin"/>
					</HBox>
				</uxap:snappedHeading>

				<uxap:actions>
					<Button text="Open Advisory" type="Emphasized" press=".onOpenStep" app:step="2"/>
					<Button text="Edit" icon="sap-icon://edit" press=".onNotImplemented"/>
					<Button text="Share" icon="sap-icon://share-2" press=".onNotImplemented"/>
				</uxap:actions>
			</uxap:ObjectPageDynamicHeaderTitle>
		</uxap:headerTitle>

		<uxap:headerContent>
			<HBox wrap="Wrap" class="kxHeaderKpis">
				<VBox class="kxKpi">
					<Label text="Aggregate commitment"/>
					<ObjectNumber number="{view>/req/valueText}" unit="AED" emphasized="true"/>
					<Text text="incl. 7% burden" class="kxSubText"/>
				</VBox>
				<VBox class="kxKpi">
					<Label text="Lines"/>
					<Title text="{view>/req/lineCount}" level="H3"/>
					<Text text="{view>/req/instances} instances · {view>/req/wbsCount} WBS" class="kxSubText"/>
				</VBox>
				<VBox class="kxKpi">
					<Label text="Mobilization window"/>
					<Title text="{view>/req/window}" level="H5"/>
					<Text text="all lead-times cleared" class="kxSubText"/>
				</VBox>
				<VBox class="kxKpi">
					<Label text="Routing"/>
					<Title text="2 own · 3 rental" level="H5"/>
					<Text text="decided at advisory" class="kxSubText"/>
				</VBox>
				<VBox class="kxKpi">
					<Label text="Raised by"/>
					<Title text="{view>/req/raisedBy}" level="H5"/>
					<Text text="{view>/req/raisedOn}" class="kxSubText"/>
				</VBox>
			</HBox>
		</uxap:headerContent>

		<uxap:sections>

			<!-- ===================== DOCUMENT FLOW ===================== -->
			<uxap:ObjectPageSection title="Document Flow" id="secFlow">
				<uxap:subSections>
					<uxap:ObjectPageSubSection>
						<uxap:blocks>
							<core:Fragment fragmentName="konstryx.view.ProcessChain" type="XML"/>
						</uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>

			<!-- ===================== IDENTITY ===================== -->
			<uxap:ObjectPageSection title="Request Identity" id="secIdentity">
				<uxap:subSections>
					<uxap:ObjectPageSubSection>
						<uxap:blocks>
							<form:SimpleForm
								editable="false"
								layout="ColumnLayout"
								columnsM="2"
								columnsL="3"
								columnsXL="4">
								<Label text="Request ID"/>       <Text text="{view>/req/id}"/>
								<Label text="Request type"/>     <Text text="{view>/req/type} · {view>/req/typeName}"/>
								<Label text="Title"/>            <Text text="{view>/req/title}"/>
								<Label text="Line count"/>       <Text text="{view>/req/lineCount} lines · {view>/req/instances} instances"/>
								<Label text="Project"/>          <Text text="{view>/req/project} · {view>/req/projectName}"/>
								<Label text="Need-by window"/>   <Text text="{view>/req/window}"/>
								<Label text="Raised by"/>        <Text text="{view>/req/raisedBy}"/>
								<Label text="Raised on"/>        <Text text="{view>/req/raisedOn}"/>
								<Label text="Advisory committee"/><Text text="{view>/req/committee}"/>
								<Label text="Approved by"/>      <Text text="{view>/req/approvedBy}"/>
								<Label text="Dominant line"/>    <Text text="{view>/req/dominantLine}"/>
								<Label text="Status"/>           <ObjectStatus text="{view>/req/state}" state="{view>/req/stateType}"/>
							</form:SimpleForm>
						</uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>

			<!-- ===================== LINE ITEMS ===================== -->
			<uxap:ObjectPageSection title="Line Items" id="secLines">
				<uxap:subSections>
					<uxap:ObjectPageSubSection>
						<uxap:blocks>
							<Table
								id="lineTable"
								items="{path: 'view>/req/lines', templateShareable: false}"
								mode="None"
								sticky="ColumnHeaders"
								alternateRowColors="false">
								<headerToolbar>
									<OverflowToolbar>
										<Title text="Line items ({view>/req/lineCount})" level="H4"/>
										<Text text="Each line = one equipment class × one WBS × one instance count × one mobilization window. Routing is decided per line at advisory." class="kxSubText sapUiTinyMarginBegin"/>
										<ToolbarSpacer/>
										<Button icon="sap-icon://add" text="Add line" type="Transparent" press=".onNotImplemented"/>
									</OverflowToolbar>
								</headerToolbar>
								<columns>
									<Column width="3.5rem"><Text text="#"/></Column>
									<Column><Text text="Equipment"/></Column>
									<Column width="8rem" minScreenWidth="Desktop" demandPopin="true"><Text text="Code"/></Column>
									<Column width="11rem" minScreenWidth="Tablet" demandPopin="true"><Text text="WBS / CBS"/></Column>
									<Column width="7rem" hAlign="End"><Text text="Inst × days"/></Column>
									<Column width="11rem"><Text text="Source"/></Column>
									<Column width="8rem" hAlign="End"><Text text="Rate/day"/></Column>
									<Column width="9rem" hAlign="End"><Text text="Line value"/></Column>
									<Column width="10rem"><Text text="Status"/></Column>
								</columns>
								<items>
									<ColumnListItem type="Active" press=".onLinePress">
										<cells>
											<ObjectStatus text="{view>no}" state="{= ${view>dominant} ? 'Information' : 'None'}" inverted="{view>dominant}"/>
											<VBox>
												<Text text="{view>resource}"/>
												<Text text="{= ${view>dominant} ? 'dominant line' : '' }" class="kxSubText"/>
											</VBox>
											<Text text="{view>code}" class="kxMono"/>
											<VBox>
												<Text text="{view>wbs}"/>
												<Text text="{view>wbsName} · CBS {view>cbs}" class="kxSubText"/>
											</VBox>
											<Text text="{view>qty} × {view>days} d"/>
											<ObjectStatus text="{view>source} · {view>sourceDetail}" state="{view>sourceState}"/>
											<ObjectNumber number="{view>rate}" unit="AED"/>
											<ObjectNumber number="{path: 'view>value', formatter: '.formatNumber'}" unit="AED" emphasized="{view>dominant}"/>
											<ObjectStatus text="{view>status}" state="{view>statusState}"/>
										</cells>
									</ColumnListItem>
								</items>
							</Table>
						</uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>

			<!-- ===================== BUDGET ===================== -->
			<uxap:ObjectPageSection title="WBS / CBS Allocation" id="secBudget">
				<uxap:subSections>
					<uxap:ObjectPageSubSection>
						<uxap:blocks>
							<Table items="{path: 'view>/wbs', templateShareable: false}" mode="None">
								<columns>
									<Column width="9rem"><Text text="WBS"/></Column>
									<Column><Text text="Description"/></Column>
									<Column width="6rem" hAlign="End"><Text text="Lines"/></Column>
									<Column width="11rem" hAlign="End"><Text text="This request"/></Column>
									<Column width="11rem" hAlign="End"><Text text="Headroom"/></Column>
									<Column width="8rem"><Text text="Check"/></Column>
								</columns>
								<items>
									<ColumnListItem>
										<cells>
											<Text text="{view>wbs}" class="kxMono"/>
											<Text text="{view>name}"/>
											<Text text="{view>lines}"/>
											<ObjectNumber number="{path: 'view>value', formatter: '.formatNumber'}" unit="AED"/>
											<ObjectNumber number="{path: 'view>headroom', formatter: '.formatNumber'}" unit="AED"/>
											<ObjectStatus text="{view>check}" state="{view>checkState}"/>
										</cells>
									</ColumnListItem>
								</items>
							</Table>
						</uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>

		</uxap:sections>

		<uxap:footer>
			<OverflowToolbar>
				<ToolbarSpacer/>
				<Button text="Reject" type="Reject" press=".onNotImplemented"/>
				<Button text="Approve &amp; send to Advisory" type="Accept" press=".onOpenStep" app:step="2"/>
			</OverflowToolbar>
		</uxap:footer>

	</uxap:ObjectPageLayout>
</mvc:View>
