<mvc:View
	controllerName="konstryx.controller.Projects"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.f"
	height="100%">

	<f:DynamicPage id="projectsPage" headerExpanded="true" fitContent="false">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="Projects" level="H2"/>
				</f:heading>
				<f:expandedContent>
					<Text visible="{/ui/showGuidanceText}" text="Mastered in KONSTRYX. A project reads NOT_SENT until the S/4 connector confirms it — nothing downstream should post against one that has not arrived."/>
				</f:expandedContent>
			</f:DynamicPageTitle>
		</f:title>

		<f:content>
			<Table
				id="projectTable"
				items="{path: 'pj>/Projects', parameters: {$filter: 'IsActiveEntity eq true', $orderby: 'code'}, templateShareable: false}"
				sticky="ColumnHeaders"
				class="sapUiResponsiveMargin"
				width="auto">

				<headerToolbar>
					<OverflowToolbar>
						<Title id="projectCount" text="Projects" level="H4"/>
						<ToolbarSpacer/>
						<Button id="newProjectButton" text="New project" icon="sap-icon://add"
							type="Emphasized" press=".onNewProject"/>
						<!-- Here rather than in an administration screen because this is
						     where its absence bites: a release fails on a plant or a
						     profit centre S/4 has never heard of, and this is the screen
						     you are standing on when it does. It belongs in the admin
						     module once that exists. -->
						<Button id="syncOrgButton" text="S/4 org values"
							icon="sap-icon://synchronize" type="Transparent"
							visible="{/user/isAdmin}" press=".onSyncOrg"/>
						<ObjectStatus text="live · CAP OData V4" state="Success" icon="sap-icon://connected" visible="{/ui/showIntegrationStatus}"/>
					</OverflowToolbar>
				</headerToolbar>

				<columns>
					<Column width="9rem"><Text text="Project"/></Column>
					<Column minScreenWidth="Tablet" demandPopin="true"><Text text="Name"/></Column>
					<Column width="8rem"><Text text="Stage"/></Column>
					<Column width="12rem" hAlign="End"><Text text="Contract value"/></Column>
					<Column width="10rem" visible="{/ui/showIntegrationStatus}"><Text text="S/4 sync"/></Column>
					<Column width="9rem" hAlign="End"><Text text=""/></Column>
				</columns>

				<items>
					<ColumnListItem>
						<cells>
							<!-- The object key is a hyperlink with one or more targets,
							     configurable per user - the S/4 smart-link pattern. -->
							<Link text="{pj>code}" emphasized="true" press=".onProjectLink"/>
							<Text text="{pj>name}"/>
							<Text text="{pj>stage}"/>
							<ObjectNumber
								number="{path: 'pj>contractValue', type: 'sap.ui.model.odata.type.Decimal', formatOptions: {groupingEnabled: true, minFractionDigits: 0, maxFractionDigits: 0}}"
								unit="{pj>ccy_code}"/>
							<ObjectStatus
								text="{pj>syncStatus}"
								state="{= ${pj>syncStatus} === 'SENT' ? 'Success' : ${pj>syncStatus} === 'FAILED' ? 'Error' : 'Warning' }"
								icon="{= ${pj>syncStatus} === 'SENT' ? 'sap-icon://connected' : 'sap-icon://disconnected' }"/>
							<!-- Hidden once the project is in S/4 rather than disabled:
							     a greyed button invites a click and then explains why
							     it was refused, and there is nothing to retry. -->
							<Button
								text="Release to S/4"
								type="Transparent"
								icon="sap-icon://journey-arrive"
								visible="{= ${pj>syncStatus} !== 'SENT' }"
								press=".onReleaseToS4"/>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</f:content>
	</f:DynamicPage>
</mvc:View>
