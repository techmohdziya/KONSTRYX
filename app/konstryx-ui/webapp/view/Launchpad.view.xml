<mvc:View
	controllerName="konstryx.controller.Launchpad"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.f"
	height="100%">

	<Page id="launchpadPage" showHeader="false" class="kxLaunchpad">
		<content>
			<VBox class="kxLaunchpadHeader">
				<Title text="Engineering Construction &amp; Operations" level="H2"/>
			</VBox>

<!-- The wireframe's segregation is the group reference: Setup & Budget,
			     then the Resource Workflow split by process phase, then Masters.
			     Groups are built by a controller factory - nested XML templates
			     leave ghost clones, and a launchpad with phantom tiles is exactly
			     the kind of sloppiness the grouping exists to prevent. -->
			<VBox id="tileGroupHost"/>

			<Title text="Master Data" level="H4" class="kxGroupTitle"/>
			<Text
				text="Stewarded masters. A group master is shared across every company; a company master is local to one legal entity until a steward promotes it."
				class="kxGroupSub"/>
			<f:GridContainer id="masterTileGrid" snapToRow="true" items="{path: '/masterTiles', templateShareable: false}">
				<f:layout>
					<f:GridContainerSettings rowSize="5.5rem" columnSize="5.5rem" gap="0.5rem"/>
				</f:layout>
				<GenericTile header="{title}" subheader="{subtitle}" press=".onTilePress">
					<layoutData>
						<f:GridContainerItemLayoutData columns="2" rows="2"/>
					</layoutData>
					<TileContent unit="{unit}">
						<NumericContent value="{value}" valueColor="{state}" icon="{icon}" withMargin="false"/>
					</TileContent>
				</GenericTile>
			</f:GridContainer>

			<Title text="Canonical thread" level="H4" class="kxGroupTitle"/>
			<Text
				text="The Equipment chain for RR-2026-0188 · Site Plant Mobilization is built end to end. Open it to walk all ten steps."
				class="kxGroupSub"/>
			<Button
				text="Open RR-2026-0188 · Site Plant Mobilization"
				type="Emphasized"
				icon="sap-icon://activity-items"
				press=".onOpenCanonical"
				class="sapUiSmallMarginTop sapUiSmallMarginBegin"/>
		</content>
	</Page>
</mvc:View>
