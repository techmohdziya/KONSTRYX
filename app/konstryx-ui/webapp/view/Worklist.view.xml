<mvc:View
	controllerName="konstryx.controller.Worklist"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.f"
	xmlns:core="sap.ui.core"
	height="100%">

	<f:DynamicPage id="worklistPage" headerExpanded="true" fitContent="false">

		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<!-- The saved view sits in the title, where S/4 puts it. Its
					     variants live in KONSTRYX's own UserVariant table rather
					     than in the Flexibility service, so they back up and
					     restore with the rest of the tenant's data. -->
					<VariantManagement id="worklistVariant"
					                   showSetAsDefault="true"
					                   supportFavorites="false"
					                   supportPublic="true"
					                   select=".onVariantSelect"
					                   save=".onVariantSave"/>
				</f:heading>
				<f:snappedHeading>
					<Title text="{view>/title}" level="H2"/>
				</f:snappedHeading>
				<f:expandedContent>
					<Text text="{view>/subtitle}"/>
				</f:expandedContent>
				<f:actions>
					<Button text="Create" type="Emphasized" icon="sap-icon://add" press=".onNotImplemented"/>
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>

		<f:header>
			<f:DynamicPageHeader pinnable="true">
				<HBox wrap="Wrap" class="kxFilterBar" alignItems="End">
					<VBox class="kxFilterField">
						<Label text="Project"/>
						<Select selectedKey="PRJ-001" autoAdjustWidth="true" change=".onFilterChange">
							<core:Item key="PRJ-001" text="PRJ-001 · Marina Heights Tower"/>
							<core:Item key="ALL" text="All projects"/>
						</Select>
					</VBox>
					<VBox class="kxFilterField">
						<Label text="Resource type"/>
						<Select id="typeFilter" selectedKey="ALL" change=".onFilterChange">
							<core:Item key="ALL" text="All types"/>
							<core:Item key="EQR" text="EQR · Equipment / Plant"/>
							<core:Item key="MR" text="MR · Material"/>
							<core:Item key="MPR" text="MPR · Manpower"/>
							<core:Item key="VR" text="VR · Vehicle"/>
						</Select>
					</VBox>
					<VBox class="kxFilterField">
						<Label text="Search"/>
						<SearchField id="worklistSearch" width="16rem" liveChange=".onSearch" placeholder="Document ID or title"/>
					</VBox>
					<VBox class="kxFilterField">
						<Label text=" "/>
						<HBox>
							<Button text="Adapt Filters" icon="sap-icon://filter"
							        tooltip="Choose which filters appear here"
							        press=".onAdaptFilters"/>
							<Button text="Go" type="Emphasized" press=".onFilterChange" class="sapUiTinyMarginBegin"/>
						</HBox>
					</VBox>
				</HBox>
			</f:DynamicPageHeader>
		</f:header>

		<f:content>
		  <VBox fitContainer="true">
			<!--
				Step 1 (RR) is served live from the CAP WorkflowService; the
				RequestOverview projection rolls up line count and value on the
				server. Steps 2-10 still come from the JSON fixture because
				MOB/OPL/VAR/DMB/CLS are not modelled in CAP yet.
			-->
			<Table
				id="requestTable"
				visible="{= ${view>/docType} === 'RR' }"
				items="{path: 'kx>/RequestOverview', parameters: {'$orderby': 'docNo'}, templateShareable: false}"
				growing="true"
				growingThreshold="25"
				sticky="ColumnHeaders"
				mode="None"
				class="sapUiResponsiveMargin"
				width="auto">

				<headerToolbar>
					<OverflowToolbar>
						<Title text="{view>/tableTitle}" level="H4"/>
						<ToolbarSpacer/>
						<Button icon="sap-icon://excel-attachment" text="Export to Excel"
						        tooltip="Download the list as it is arranged here"
						        press=".onExportExcel"/>
						<Button icon="sap-icon://print" text="Print"
						        tooltip="Print, or save as PDF from the print dialog"
						        press=".onPrint"/>
						<Button icon="sap-icon://action-settings" tooltip="Columns, sort, group and filter"
						        press=".onTableSettings"/>
						<ObjectStatus text="live · CAP OData V4" state="Success" icon="sap-icon://connected"/>
					</OverflowToolbar>
				</headerToolbar>

				<!-- Column ids are the personalization keys: the engine identifies a
				     column by id, so these must match the field keys the controller
				     registers. -->
				<columns>
					<Column id="docNo" width="11rem"><Text text="{view>/idColumn}"/></Column>
					<Column id="verticalType" width="5.5rem"><Text text="Type"/></Column>
					<Column id="projectName" minScreenWidth="Tablet" demandPopin="true"><Text text="Project"/></Column>
					<Column id="lineCount" width="10rem" minScreenWidth="Desktop" demandPopin="true"><Text text="Scope"/></Column>
					<Column id="needBy" width="14rem" minScreenWidth="Desktop" demandPopin="true"><Text text="Need by"/></Column>
					<Column id="totalValue" width="10rem" hAlign="End"><Text text="Value"/></Column>
					<Column id="status" width="9rem"><Text text="Status"/></Column>
				</columns>

				<items>
					<ColumnListItem type="Navigation" press=".onRequestPress">
						<cells>
							<ObjectIdentifier title="{kx>docNo}" text="{path: 'kx>raisedOn', type: 'sap.ui.model.odata.type.Date', formatOptions: {style: 'medium'}}"/>
							<ObjectStatus text="{kx>verticalType}" inverted="true" state="Information"/>
							<VBox>
								<Text text="{kx>projectName}"/>
								<Text text="{kx>projectCode} · {kx>raisedBy}" class="kxSubText"/>
							</VBox>
							<Text text="{kx>lineCount} lines"/>
							<Text text="{path: 'kx>needBy', type: 'sap.ui.model.odata.type.Date', formatOptions: {style: 'medium'}}"/>
							<ObjectNumber
								number="{path: 'kx>totalValue', type: 'sap.ui.model.odata.type.Decimal', formatOptions: {groupingEnabled: true, minFractionDigits: 0, maxFractionDigits: 0}}"
								unit="AED"/>
							<ObjectStatus text="{kx>status}" state="{= ${kx>status} === 'Approved' ? 'Success' : 'Warning' }"/>
						</cells>
					</ColumnListItem>
				</items>
			</Table>

			<Table
				id="worklistTable"
				visible="{= ${view>/docType} !== 'RR' }"
				items="{path: 'view>/rows', templateShareable: false}"
				growing="true"
				growingThreshold="25"
				sticky="ColumnHeaders"
				mode="None"
				class="sapUiResponsiveMargin"
				width="auto">

				<headerToolbar>
					<OverflowToolbar>
						<Title text="{view>/tableTitle}" level="H4"/>
						<ToolbarSpacer/>
						<Button icon="sap-icon://sort" type="Transparent" press=".onNotImplemented" tooltip="Sort"/>
						<Button icon="sap-icon://filter" type="Transparent" press=".onNotImplemented" tooltip="Filter"/>
						<Button icon="sap-icon://action-settings" type="Transparent" press=".onNotImplemented" tooltip="Table settings"/>
					</OverflowToolbar>
				</headerToolbar>

				<columns>
					<Column width="11rem"><Text text="{view>/idColumn}"/></Column>
					<Column width="5.5rem"><Text text="Type"/></Column>
					<Column minScreenWidth="Tablet" demandPopin="true"><Text text="Description"/></Column>
					<Column width="10rem" minScreenWidth="Desktop" demandPopin="true"><Text text="Scope"/></Column>
					<Column width="14rem" minScreenWidth="Desktop" demandPopin="true"><Text text="Window"/></Column>
					<Column width="10rem" hAlign="End"><Text text="Value"/></Column>
					<Column width="9rem"><Text text="Status"/></Column>
				</columns>

				<items>
					<ColumnListItem type="Navigation" press=".onRowPress">
						<cells>
							<ObjectIdentifier title="{view>id}" text="{view>date}"/>
							<ObjectStatus text="{view>type}" inverted="true" state="Information"/>
							<VBox>
								<Text text="{view>title}"/>
								<Text text="{view>sub}" class="kxSubText"/>
							</VBox>
							<Text text="{view>scope}"/>
							<Text text="{view>window}"/>
							<ObjectNumber number="{view>valueText}" unit="AED"/>
							<ObjectStatus text="{view>status}" state="{view>statusState}"/>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		  </VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
