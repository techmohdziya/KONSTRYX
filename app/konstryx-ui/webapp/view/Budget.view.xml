<mvc:View
	controllerName="konstryx.controller.Budget"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.f"
	xmlns:core="sap.ui.core"
	height="100%">

	<f:DynamicPage id="budgetPage" headerExpanded="true" fitContent="false">

		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title id="budgetTitle" text="Project Budgets" level="H2"/>
				</f:heading>
				<f:expandedContent>
					<Text id="budgetSubtitle" text="Every dirham of budget movement is one ledger entry — generate, submit, baseline, then adjust only through Shift, Risk Transfer or Variation."/>
				</f:expandedContent>
				<f:actions>
					<Button id="newBudgetBtn" text="+ New Budget" type="Emphasized" icon="sap-icon://add"
					        press=".onNewBudget"/>
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>

		<f:content>
			<Table
				id="budgetTable"
				items="{path: 'bud>/Budgets', templateShareable: false}"
				sticky="ColumnHeaders"
				noDataText="No budget yet for this project. Use + New Budget to create the first one."
				class="sapUiResponsiveMargin"
				width="auto">

				<headerToolbar>
					<OverflowToolbar>
						<Title id="budgetTableTitle" text="Budgets" level="H4"/>
						<ToolbarSpacer/>
						<Button icon="sap-icon://excel-attachment" text="Export to Excel"
						        tooltip="Download the list as it is arranged here" press=".onExportExcel"/>
					</OverflowToolbar>
				</headerToolbar>

				<columns>
					<Column id="docNo" width="12rem"><Text text="Document"/></Column>
					<Column id="version" width="7rem"><Text text="Version"/></Column>
					<Column id="status" width="10rem"><Text text="Status"/></Column>
					<Column id="totalAmount" hAlign="End"><Text text="Total Amount"/></Column>
					<Column id="daysToLock" width="9rem" hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Days→Lock"/></Column>
					<Column id="raisedBy" width="12rem" minScreenWidth="Desktop" demandPopin="true"><Text text="Raised by"/></Column>
					<Column id="raisedOn" width="9rem" minScreenWidth="Desktop" demandPopin="true"><Text text="Raised on"/></Column>
				</columns>

				<items>
					<ColumnListItem type="Active" press=".onOpenBudget">
						<cells>
							<ObjectIdentifier title="{bud>docNo}"/>
							<Text text="{bud>version}"/>
							<ObjectStatus text="{= ${bud>status} || 'Draft' }"
								state="{= ${bud>status} === 'Approved' || ${bud>status} === 'Baselined' || ${bud>status} === 'Locked' ? 'Success' : !${bud>status} || ${bud>status} === 'Draft' ? 'None' : 'Warning' }"/>
							<ObjectNumber
								number="{path: 'bud>totalAmount', type: 'sap.ui.model.odata.type.Decimal', formatOptions: {groupingEnabled: true, maxFractionDigits: 2}}"
								unit="AED"/>
							<Text text="{= ${bud>daysToLock} !== null &amp;&amp; ${bud>daysToLock} !== undefined ? ${bud>daysToLock} : '—' }"/>
							<Text text="{bud>raisedBy}"/>
							<Text text="{bud>raisedOn}"/>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</f:content>
	</f:DynamicPage>
</mvc:View>
