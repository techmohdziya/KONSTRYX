<mvc:View
	controllerName="konstryx.controller.ManpowerOverview"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:uxap="sap.uxap"
	height="100%">

	<!-- An ObjectPageLayout rather than a DynamicPage with two tables stacked in a
	     VBox. The screen has genuinely separate blocks — the crews reserved, and
	     the daily log that costs them — and the anchor bar is how the rest of this
	     app presents that (chain step, request detail, budget detail). Stacked
	     tables gave no section titles, no way to jump, and no spacing discipline. -->
	<uxap:ObjectPageLayout
		id="manpowerObjectPage"
		showTitleInHeaderContent="true"
		alwaysShowContentHeader="false"
		headerContentPinnable="true"
		preserveHeaderStateOnScroll="false"
		upperCaseAnchorBar="false">

		<uxap:headerTitle>
			<uxap:ObjectPageDynamicHeaderTitle>
				<uxap:breadcrumbs>
					<Breadcrumbs currentLocationText="Manpower">
						<Link text="Home" press=".onBreadcrumbHome"/>
					</Breadcrumbs>
				</uxap:breadcrumbs>

				<uxap:expandedHeading>
					<HBox alignItems="Center" wrap="Wrap">
						<Title text="Manpower" level="H2"/>
						<ObjectStatus text="{view>/kpi/heads} heads on site" inverted="true"
							state="Information" class="sapUiTinyMarginBegin"/>
					</HBox>
				</uxap:expandedHeading>
				<uxap:snappedHeading>
					<HBox alignItems="Center">
						<Title text="Manpower" level="H2"/>
						<ObjectStatus text="{view>/kpi/heads} heads" state="Information"
							class="sapUiTinyMarginBegin"/>
					</HBox>
				</uxap:snappedHeading>

				<uxap:actions>
					<Button text="Refresh" icon="sap-icon://refresh" press=".onRefresh"/>
				</uxap:actions>
			</uxap:ObjectPageDynamicHeaderTitle>
		</uxap:headerTitle>

		<uxap:headerContent>
			<!-- What a manpower coordinator reads first: how many heads are on site,
			     how they split between own payroll and subcontract, what that costs,
			     and how much of it has actually been logged. -->
			<HBox wrap="Wrap" class="kxHeaderKpis">
				<VBox class="kxKpi">
					<Label text="Heads reserved"/>
					<Title text="{view>/kpi/heads}" level="H3"/>
					<Text text="across {view>/lineCount} crews" class="kxSubText"/>
				</VBox>
				<VBox class="kxKpi">
					<Label text="Own vs subcontract"/>
					<Title text="{view>/kpi/ownHeads} own · {view>/kpi/lscHeads} LSC" level="H5"/>
					<Text text="decided at advisory" class="kxSubText"/>
				</VBox>
				<VBox class="kxKpi">
					<Label text="Committed"/>
					<ObjectNumber number="{view>/kpi/committed}" unit="AED" emphasized="true"/>
					<Text text="heads × days × rate" class="kxSubText"/>
				</VBox>
				<VBox class="kxKpi">
					<Label text="Hours logged"/>
					<Title text="{view>/kpi/hours}" level="H3"/>
					<Text text="incl. {view>/kpi/otHours} overtime" class="kxSubText"/>
				</VBox>
				<VBox class="kxKpi">
					<Label text="Logged cost"/>
					<ObjectNumber number="{view>/kpi/loggedCost}" unit="AED"/>
					<Text text="signed days only" class="kxSubText"/>
				</VBox>
			</HBox>
		</uxap:headerContent>

		<uxap:sections>

			<!-- ===================== CREWS ===================== -->
			<uxap:ObjectPageSection title="Crews" id="secCrews">
				<uxap:subSections>
					<uxap:ObjectPageSubSection>
						<uxap:blocks>
							<Table
								id="manpowerTable"
								items="{path: 'view>/lines', templateShareable: false}"
								mode="None"
								sticky="ColumnHeaders"
								busy="{view>/busy}"
								alternateRowColors="false">

								<headerToolbar>
									<OverflowToolbar>
										<Title text="Crews ({view>/lineCount})" level="H4"/>
										<ToolbarSpacer/>
										<Button icon="sap-icon://excel-attachment" text="Export to Excel"
										        tooltip="Download the list as it is arranged here"
										        press=".onExportCrews"/>
									</OverflowToolbar>
								</headerToolbar>

								<!-- Eight columns, not ten, and only one of them flexible.
								     Ten fixed columns came to 1,396px on their own, which is
								     wider than a 1280px window: the table gave the flexible
								     Trade column what was left, and what was left was nothing,
								     so the primary identifier rendered at zero width. Related
								     facts are paired into one cell instead — heads with their
								     window, the committed value with the rate behind it — which
								     both fits and reads better than a row of thin columns. -->
								<columns>
									<Column width="3rem"><Text text="#"/></Column>
									<Column><Text text="Trade"/></Column>
									<Column width="9rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Crew"/></Column>
									<Column width="10rem"><Text text="Source"/></Column>
									<Column width="9rem" hAlign="End"><Text text="Heads × days"/></Column>
									<Column width="10.5rem" hAlign="End"><Text text="Committed"/></Column>
									<Column width="8rem" minScreenWidth="Tablet" demandPopin="true"><Text text="WBS / CBS"/></Column>
									<Column width="8rem"><Text text="Status"/></Column>
								</columns>

								<items>
									<ColumnListItem type="Navigation" press=".onLinePress">
										<cells>
											<Text text="{view>lineNo}"/>
											<VBox>
												<Text text="{view>trade}"/>
												<Text text="{view>inductionState}" class="kxSubText"/>
											</VBox>
											<VBox>
												<Text text="{view>crewId}"/>
												<Text text="{view>crewLead}" class="kxSubText"/>
											</VBox>
											<!-- Own payroll or a labour subcontractor. The vendor matters
											     commercially, so it is named rather than implied. -->
											<ObjectStatus
												text="{view>sourceLabel}"
												state="{= ${view>sourceType} === 'OWN' ? 'Success' : 'Information' }"/>
											<VBox>
												<Text text="{view>headsDaysText}"/>
												<Text text="{view>window}" class="kxSubText"/>
											</VBox>
											<VBox>
												<ObjectNumber number="{view>committedText}" unit="AED" emphasized="true"/>
												<Text text="at {view>rateText}/head-day" class="kxSubText"/>
											</VBox>
											<VBox>
												<Text text="{view>wbsCode}"/>
												<Text text="CBS {view>cbsCode}" class="kxSubText"/>
											</VBox>
											<ObjectStatus text="{view>lineStatus}"
												state="{= ${view>lineStatus} === 'Closed' ? 'None' : 'Success' }"/>
										</cells>
									</ColumnListItem>
								</items>
							</Table>
						</uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>

			<!-- ===================== DAILY LOG ===================== -->
			<uxap:ObjectPageSection title="Daily Log" id="secLog">
				<uxap:subSections>
					<uxap:ObjectPageSubSection>
						<uxap:blocks>
							<Table
								id="timesheetTable"
								items="{path: 'view>/timesheets', templateShareable: false}"
								mode="None"
								sticky="ColumnHeaders"
								busy="{view>/busy}"
								alternateRowColors="false">

								<headerToolbar>
									<OverflowToolbar>
										<Title text="Logged days ({view>/timesheetCount})" level="H4"/>
										<ToolbarSpacer/>
										<Button icon="sap-icon://excel-attachment" text="Export to Excel"
										        tooltip="Download the log as it is arranged here"
										        press=".onExportLog"/>
									</OverflowToolbar>
								</headerToolbar>

								<columns>
									<Column width="7rem"><Text text="Date"/></Column>
									<Column><Text text="Crew / trade"/></Column>
									<Column width="8rem" hAlign="End"><Text text="Present"/></Column>
									<Column width="7rem" hAlign="End"><Text text="Regular"/></Column>
									<Column width="6rem" hAlign="End"><Text text="OT"/></Column>
									<Column width="14rem" minScreenWidth="Desktop" demandPopin="true"><Text text="Activity"/></Column>
									<Column width="10rem" hAlign="End"><Text text="Cost"/></Column>
									<Column width="9rem"><Text text="Log"/></Column>
								</columns>

								<items>
									<ColumnListItem>
										<cells>
											<Text text="{view>workDate}"/>
											<VBox>
												<Text text="{view>crewId}"/>
												<Text text="{view>trade}" class="kxSubText"/>
											</VBox>
											<!-- Short of the reserved head count is the thing a foreman
											     is asked about, so it is stated as a comparison. -->
											<ObjectStatus
												text="{view>presentText}"
												state="{= ${view>headsPresent} &lt; ${view>headsReserved} ? 'Warning' : 'Success' }"/>
											<Text text="{view>regularHrs}"/>
											<Text text="{view>otHrs}"/>
											<Text text="{view>activity}" class="kxMono"/>
											<ObjectNumber number="{view>costText}" unit="AED"/>
											<ObjectStatus text="{view>logStatus}"
												state="{= ${view>logStatus} === 'Signed' ? 'Success' : 'Warning' }"/>
										</cells>
									</ColumnListItem>
								</items>
							</Table>
						</uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>

		</uxap:sections>
	</uxap:ObjectPageLayout>
</mvc:View>
