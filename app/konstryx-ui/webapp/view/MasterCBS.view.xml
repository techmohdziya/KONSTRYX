<mvc:View
	controllerName="konstryx.controller.MasterCBS"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.f"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table"
	height="100%">

	<f:DynamicPage id="cbsPage" headerExpanded="true" fitContent="true">

		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="CBS Library" level="H2"/>
				</f:heading>
				<f:expandedContent>
					<Text text="Cost breakdown structure, L1 to L3. Projects instantiate their own CBS from this library."/>
				</f:expandedContent>
				<f:actions>
					<Button text="Create" type="Emphasized" icon="sap-icon://add" press=".onNotImplemented"/>
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>

		<f:header>
			<f:DynamicPageHeader pinnable="true">
				<HBox wrap="Wrap" class="kxFilterBar" alignItems="End">
					<VBox class="kxFilterField">
						<Label text="Scope"/>
						<Select id="scopeFilter" selectedKey="ALL" change=".onFilterChange">
							<core:Item key="ALL" text="All scopes"/>
							<core:Item key="GROUP" text="Group - shared"/>
							<core:Item key="COMPANY" text="Company - local"/>
						</Select>
					</VBox>
					<VBox class="kxFilterField">
						<Label text="Level"/>
						<Select id="levelFilter" selectedKey="ALL" change=".onFilterChange">
							<core:Item key="ALL" text="All levels"/>
							<core:Item key="L1" text="L1 - phase"/>
							<core:Item key="L2" text="L2"/>
							<core:Item key="L3" text="L3"/>
						</Select>
					</VBox>
					<VBox class="kxFilterField">
						<Label text="Search"/>
						<SearchField id="cbsSearch" width="16rem" liveChange=".onSearch" placeholder="Code or phase"/>
					</VBox>
				</HBox>
			</f:DynamicPageHeader>
		</f:header>

		<f:content>
			<!-- A TreeTable, not a list. The CBS is a cost breakdown structure:
			     which node rolls up into which is the whole meaning of it, and a
			     flat table sorted by code hides exactly that. -->
			<t:TreeTable
				id="cbsTree"
				rows="{path: 'tree>/nodes', parameters: {arrayNames: ['children']}}"
				selectionMode="Single"
				selectionBehavior="RowOnly"
				rowSelectionChange=".onSelect"
				visibleRowCountMode="Fixed"
				visibleRowCount="16"
				enableColumnReordering="true">

				<t:extension>
					<OverflowToolbar>
						<Title id="tableTitle" text="CBS nodes" level="H4"/>
						<ToolbarSpacer/>
						<Button icon="sap-icon://expand-all" text="Expand all" press=".onExpandAll"/>
						<Button icon="sap-icon://collapse-all" text="Collapse" press=".onCollapseAll"/>
						<ObjectStatus text="live · CAP OData V4" state="Success" icon="sap-icon://connected"/>
					</OverflowToolbar>
				</t:extension>

				<t:columns>
					<t:Column width="18rem">
						<Label text="Code"/>
						<t:template>
							<!-- emphasized, not class: class is not bindable in an XML view. -->
							<ObjectIdentifier title="{tree>code}"
							                  titleActive="false"
							                  text="{= ${tree>isMatch} ? '' : 'shown for context' }"/>
						</t:template>
					</t:Column>
					<t:Column width="5rem">
						<Label text="Level"/>
						<t:template><Text text="{tree>level}"/></t:template>
					</t:Column>
					<t:Column width="16rem">
						<Label text="Phase"/>
						<t:template><Text text="{tree>phase}" wrapping="false"/></t:template>
					</t:Column>
					<t:Column width="12rem">
						<Label text="Construction type"/>
						<t:template><Text text="{tree>constructionType}"/></t:template>
					</t:Column>
					<t:Column width="10rem">
						<Label text="Resource affinity"/>
						<t:template><Text text="{tree>resourceAffinity}"/></t:template>
					</t:Column>
					<t:Column width="9rem">
						<Label text="Scope"/>
						<t:template>
							<ObjectStatus
								text="{tree>scope}"
								state="{= ${tree>scope} === 'GROUP' ? 'Success' : 'Warning' }"
								icon="{= ${tree>scope} === 'GROUP' ? 'sap-icon://group' : 'sap-icon://building' }"/>
						</t:template>
					</t:Column>
					<t:Column width="12rem">
						<Label text="Owned by"/>
						<t:template>
							<Text text="{= ${tree>owningCompany/code} ? ${tree>owningCompany/code} : 'Whole group' }"/>
						</t:template>
					</t:Column>
				</t:columns>
			</t:TreeTable>
		</f:content>

		<f:footer>
			<OverflowToolbar>
				<Text id="selectionHint" text="Select a company-scoped node to request promotion to group scope."/>
				<ToolbarSpacer/>
				<Button id="promoteButton" text="Request promotion" type="Emphasized"
					icon="sap-icon://arrow-top" enabled="false" press=".onRequestPromotion"/>
			</OverflowToolbar>
		</f:footer>
	</f:DynamicPage>
</mvc:View>
