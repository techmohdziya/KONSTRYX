<mvc:View
	controllerName="konstryx.controller.App"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	displayBlock="true"
	height="100%">

	<!--
		Content only, by design (decision D-16, 2026-08-15).

		KONSTRYX is hosted in the SAP S/4HANA Public Cloud Fiori launchpad, so
		the shell belongs to the launchpad: header, product logo, global search,
		notifications, user menu, theme and the Spaces/Pages navigation all come
		from there. An app that draws its own would show two headers stacked and
		two search fields, and would not follow the client's theme when they
		switch between Morning and Evening Horizon.

		This view was previously a sap.tnt.ToolPage carrying all of that. What it
		lost — the process-phase side navigation over the ten chain documents —
		becomes tiles on a launchpad page, one intent per document type, which is
		how S/4 surfaces task-focused apps.
	-->
	<NavContainer id="appContent" autoFocus="false"/>

</mvc:View>
