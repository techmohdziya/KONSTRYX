{
  "_version": "1.60.0",
  "sap.app": {
    "id": "konstryx",
    "type": "application",
    "title": "KONSTRYX",
    "description": "Engineering & Construction Operations on SAP BTP",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "crossNavigation": {
      "inbounds": {
        "konstryx-display": {
          "semanticObject": "KonstryxResourceRequest",
          "action": "display",
          "title": "Resource Requests",
          "subTitle": "Engineering & Construction",
          "icon": "sap-icon://activity-items",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        },
        "konstryx-reservations": {
          "semanticObject": "KonstryxReservation",
          "action": "display",
          "title": "Reservations",
          "subTitle": "Engineering & Construction",
          "icon": "sap-icon://sales-order",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    },
    "dataSources": {
      "konstryxData": {
        "uri": "model/data.json",
        "type": "JSON"
      },
      "workflowService": {
        "uri": "/odata/v4/workflow/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      },
      "masterDataService": {
        "uri": "/odata/v4/masterdata/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      },
      "projectService": {
        "uri": "/odata/v4/project/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      },
      "collaborationService": {
        "uri": "/odata/v4/collaboration/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": false
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "konstryx.view.App",
      "type": "XML",
      "async": true
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.f": {},
        "sap.tnt": {},
        "sap.uxap": {},
        "sap.ui.layout": {},
        "sap.ui.table": {},
        "sap.ui.export": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": false
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "konstryx.i18n.i18n",
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      },
      "": {
        "dataSource": "konstryxData",
        "preload": true,
        "settings": {
          "defaultBindingMode": "TwoWay"
        }
      },
      "kx": {
        "dataSource": "workflowService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true,
          "groupId": "$auto"
        }
      },
      "md": {
        "dataSource": "masterDataService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "groupId": "$auto"
        }
      },
      "pj": {
        "dataSource": "projectService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "groupId": "$auto"
        }
      },
      "collab": {
        "dataSource": "collaborationService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "groupId": "$auto"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "type": "View",
        "viewType": "XML",
        "path": "konstryx.view",
        "viewPath": "konstryx.view",
        "controlId": "appContent",
        "controlAggregation": "pages",
        "transition": "slide",
        "async": true,
        "bypassed": {
          "target": "notFound"
        }
      },
      "routes": [
        {
          "pattern": "",
          "name": "launchpad",
          "target": "launchpad"
        },
        {
          "pattern": "projects",
          "name": "projects",
          "target": "projects"
        },
        {
          "pattern": "projects/{projectId}/cbs/{cbsId}",
          "name": "projectCBS",
          "target": "projectCBS"
        },
        {
          "pattern": "projects/{projectId}",
          "name": "projectBOQ",
          "target": "projectBOQ"
        },
        {
          "pattern": "worklist/{docType}",
          "name": "worklist",
          "target": "worklist"
        },
        {
          "pattern": "request/{requestId}",
          "name": "request",
          "target": "request"
        },
        {
          "pattern": "doc/{requestId}/{step}",
          "name": "doc",
          "target": "doc"
        },
        {
          "pattern": "masters/resources",
          "name": "masterResources",
          "target": "masterResources"
        },
        {
          "pattern": "masters/cbs",
          "name": "masterCBS",
          "target": "masterCBS"
        },
        {
          "pattern": "masters/promotions",
          "name": "promotionQueue",
          "target": "promotionQueue"
        },
        {
          "pattern": "masters/rates",
          "name": "masterRates",
          "target": "masterRates"
        },
        {
          "pattern": "masters/resource/{code}",
          "name": "resourceDetail",
          "target": "resourceDetail"
        },
        {
          "pattern": "masters/norms",
          "name": "masterNorms",
          "target": "masterNorms"
        },
        {
          "pattern": "masters/templates",
          "name": "masterTemplates",
          "target": "masterTemplates"
        }
      ],
      "targets": {
        "launchpad": {
          "id": "launchpad",
          "name": "Launchpad",
          "title": "Home"
        },
        "worklist": {
          "id": "worklist",
          "name": "Worklist"
        },
        "request": {
          "id": "request",
          "name": "RequestDetail"
        },
        "doc": {
          "id": "doc",
          "name": "ChainStep"
        },
        "masterResources": {
          "id": "masterResources",
          "name": "MasterResources",
          "title": "Resource Hierarchy"
        },
        "masterCBS": {
          "id": "masterCBS",
          "name": "MasterCBS",
          "title": "CBS Library"
        },
        "promotionQueue": {
          "id": "promotionQueue",
          "name": "PromotionQueue",
          "title": "Promotion Queue"
        },
        "masterRates": {
          "id": "masterRates",
          "name": "MasterRates",
          "title": "Rate Master"
        },
        "resourceDetail": {
          "id": "resourceDetail",
          "name": "ResourceDetail",
          "title": "Resource"
        },
        "masterNorms": {
          "id": "masterNorms",
          "name": "MasterNorms",
          "title": "Norms"
        },
        "masterTemplates": {
          "id": "masterTemplates",
          "name": "MasterTemplates",
          "title": "Project Templates"
        },
        "notFound": {
          "id": "notFound",
          "name": "NotFound",
          "transition": "show"
        },
        "projects": {
          "id": "projects",
          "type": "View",
          "path": "konstryx.view",
          "name": "Projects",
          "viewName": "Projects"
        },
        "projectBOQ": {
          "id": "projectBOQ",
          "type": "View",
          "path": "konstryx.view",
          "name": "ProjectBOQ",
          "viewName": "ProjectBOQ"
        },
        "projectCBS": {
          "id": "projectCBS",
          "type": "View",
          "path": "konstryx.view",
          "name": "ProjectCBS",
          "viewName": "ProjectCBS"
        }
      }
    }
  }
}
