{
  "sap.app": {
    "id": "konstryx.dash.kpiEarned",
    "type": "card",
    "applicationVersion": {
      "version": "1.0.0"
    }
  },
  "sap.card": {
    "type": "Object",
    "data": {
      "request": {
        "url": "/odata/v4/project/Booklet?$apply={parameters>/flt/value}aggregate(adjustedValue with sum as contractTotal,earnedValue with sum as earnedTotal,actualCost with sum as spentTotal,forecastMargin with sum as marginTotal)",
        "withCredentials": true
      },
      "path": "/value/0"
    },
    "header": {
      "type": "Numeric",
      "title": "Recognised",
      "subTitle": "Measured work at contract rates",
      "unitOfMeasurement": "AED",
      "mainIndicator": {
        "number": "{= format.float(${earnedTotal}, {decimals: 2, groupingEnabled: true}) }",
        "unit": "AED",
        "state": "Good"
      }
    },
    "configuration": {
      "parameters": {
        "flt": {
          "value": "",
          "type": "string"
        }
      }
    }
  }
}
