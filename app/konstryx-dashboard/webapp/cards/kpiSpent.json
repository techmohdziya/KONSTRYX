{
  "sap.app": {
    "id": "konstryx.dash.kpiSpent",
    "type": "card",
    "applicationVersion": {
      "version": "1.0.0"
    }
  },
  "sap.card": {
    "type": "Object",
    "data": {
      "request": {
        "url": "/odata/v4/project/Booklet?$apply=aggregate(adjustedValue with sum as contractTotal,earnedValue with sum as earnedTotal,actualCost with sum as spentTotal,forecastMargin with sum as marginTotal)",
        "withCredentials": true
      },
      "path": "/value/0"
    },
    "header": {
      "type": "Numeric",
      "title": "Actual cost",
      "subTitle": "Booked to date",
      "unitOfMeasurement": "AED",
      "mainIndicator": {
        "number": "{spentTotal}",
        "unit": "AED",
        "state": "Critical",
        "scale": ""
      }
    },
    "content": {
      "groups": []
    }
  }
}
