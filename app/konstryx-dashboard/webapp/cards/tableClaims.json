{
  "sap.app": {
    "id": "konstryx.dash.tableClaims",
    "type": "card",
    "applicationVersion": {
      "version": "1.0.0"
    }
  },
  "sap.card": {
    "type": "Table",
    "data": {
      "request": {
        "url": "/odata/v4/billing/PaymentApplications?$filter=IsActiveEntity eq true{parameters>/flt/value}&$orderby=seq desc",
        "withCredentials": true
      },
      "path": "/value"
    },
    "header": {
      "title": "Client applications",
      "subTitle": "Claimed, reviewed and approved"
    },
    "content": {
      "row": {
        "columns": [
          {
            "title": "Application",
            "value": "{docNo}"
          },
          {
            "title": "Period",
            "value": "{periodName}"
          },
          {
            "title": "Proposed",
            "value": "{= format.float(${proposedGross}, {decimals: 2, groupingEnabled: true}) }"
          },
          {
            "title": "Approved",
            "value": "{= format.float(${approvedGross}, {decimals: 2, groupingEnabled: true}) }"
          },
          {
            "title": "Stage",
            "value": "{status}"
          }
        ]
      }
    },
    "configuration": {
      "parameters": {
        "flt": {
          "value": "",
          "type": "string"
        }
      }
    }
  }
}
