{
  "sap.app": {
    "id": "konstryx.dash.listFronts",
    "type": "card",
    "applicationVersion": {
      "version": "1.0.0"
    }
  },
  "sap.card": {
    "type": "List",
    "data": {
      "request": {
        "url": "/odata/v4/project/WorkFronts?$filter=state eq 'OVERDUE'{parameters>/flt/value}&$orderby=driftPct",
        "withCredentials": true
      },
      "path": "/value"
    },
    "header": {
      "title": "Overdue work fronts",
      "subTitle": "Past their finish date and not complete"
    },
    "content": {
      "maxItems": 6,
      "item": {
        "title": "{activityName}",
        "description": "{projectName} \u00b7 {wbsCode} \u00b7 {= format.float(${percentDone}, {decimals: 2}) }% done",
        "info": {
          "value": "{= format.float(${driftPct}, {decimals: 2}) }%",
          "state": "Error"
        }
      }
    },
    "configuration": {
      "parameters": {
        "flt": {
          "value": "",
          "type": "string"
        }
      }
    }
  }
}
